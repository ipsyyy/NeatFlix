# NativeFrame server-only configuration.
# Copy to .env.local (git-ignored) and fill in real values there. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix: agent credentials must never reach the browser.

# BAND agent identities (one per NativeFrame role)
BAND_CONTENT_CURATOR_AGENT_ID=your-content-curator-agent-uuid
BAND_CONTENT_CURATOR_API_KEY=your-content-curator-api-key
BAND_SCENE_SCOUT_AGENT_ID=your-scene-scout-agent-uuid
BAND_SCENE_SCOUT_API_KEY=your-scene-scout-api-key
BAND_CAMPAIGN_MATCHER_AGENT_ID=your-campaign-matcher-agent-uuid
BAND_CAMPAIGN_MATCHER_API_KEY=your-campaign-matcher-api-key
BAND_PLACEMENT_DIRECTOR_AGENT_ID=your-placement-director-agent-uuid
BAND_PLACEMENT_DIRECTOR_API_KEY=your-placement-director-api-key
BAND_RELEASE_GOVERNOR_AGENT_ID=your-release-governor-agent-uuid
BAND_RELEASE_GOVERNOR_API_KEY=your-release-governor-api-key

# BAND endpoints (optional; the BAND SDK defaults apply when unset)
BAND_REST_URL=https://your-band-rest-url.example
BAND_WS_URL=wss://your-band-websocket-url.example/api/v1/socket

# Anthropic Claude (agent reasoning)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase workflow registry (optional; server-only). When both are set, the
# agent runtime persists placement plans, media records, and Governor reviews.
# Use a Supabase secret key (sb_secret_...) from Project Settings > API Keys.
# A secret key bypasses row-level security: keep it on the server only, never
# give it a NEXT_PUBLIC_ name, and never send it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Gemini (Nano Banana) image editing (server-only). Used only by the bounded
# media:edit-still command for one approved edit. Never give it a NEXT_PUBLIC_ name.
GEMINI_API_KEY=your-gemini-api-key

# Masky agent identities (server-only, mky_...). Used only by the bounded
# agents:masky-identities command. Never give it a NEXT_PUBLIC_ name.
MASKY_API_KEY=

# LangSmith tracing and evaluation (server-only). Used only by the bounded
# langsmith:trace-case command. Tracing is off unless LANGSMITH_TRACING=true.
# LANGSMITH_ENDPOINT defaults to https://api.smith.langchain.com.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nativeframe
LANGSMITH_ENDPOINT=
